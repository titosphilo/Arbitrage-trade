# Research-only exchange access. Use read-only keys.
BINANCE_API_KEY=read_only_key_here
BINANCE_API_SECRET=read_only_secret_here

# Broker credentials belong in the VPS secret manager or local environment only.
# Never commit real values.
IG_API_KEY=replace_in_secret_manager
IG_USERNAME=replace_in_secret_manager
IG_PASSWORD=replace_in_secret_manager
IG_ACCOUNT_ID=replace_in_secret_manager

# Live execution must default to disabled.
LIVE_TRADING_ENABLED=false
PILOT_STARTING_EQUITY_GBP=500
PILOT_MAX_RISK_PER_TRADE_GBP=5
PILOT_MAX_DAILY_LOSS_GBP=10
PILOT_MAX_WEEKLY_LOSS_GBP=20
PILOT_MAX_OPEN_POSITIONS=1
PILOT_MAX_LEVERAGE=1.0
